# ============================================
# MeteorX 环境变量配置示例
# 复制为 .env 后按需修改：cp .env.example .env
#
# 两种使用场景（变量名不同，见下方分区）：
#   A. 直接运行（go run cmd/server/main.go）或 docker-compose.yml 开发环境
#      -> 使用 METEORX_* 前缀变量（代码 LoadConfig 手动绑定）
#   B. docker-compose.prod.yml 生产环境
#      -> compose 自动读取本文件，展开 ${DB_PASSWORD} 等宿主变量
# ============================================


# ============================================
# A. 直接运行 / docker-compose 开发环境（METEORX_* 前缀）
#    这些变量由 internal/bootstrap/config.go 的 envBindings 手动绑定，
#    存在 .env 时覆盖 config.yaml 中对应项。
# ============================================

# --- Server ---
# 服务监听端口（标准端口 8081）
METEORX_APP_PORT=8081
# 运行模式：debug / release
METEORX_APP_MODE=debug

# --- Database (MySQL) ---
METEORX_DB_HOST=127.0.0.1
METEORX_DB_PORT=3306
METEORX_DB_USER=root
METEORX_DB_PASSWORD=123456
METEORX_DB_NAME=meteorx
# TLS：true / false
METEORX_DB_TLS=false
# 是否输出 SQL 日志：true / false
METEORX_DB_DEBUG=false

# --- Redis ---
METEORX_REDIS_HOST=127.0.0.1
METEORX_REDIS_PORT=6379
METEORX_REDIS_PASSWORD=
METEORX_REDIS_DB=0

# --- JWT ---
# 生产环境务必改成强随机密钥
METEORX_JWT_SECRET=your-super-secret-jwt-key-change-this
# Token 有效期，如 24h / 72h
METEORX_JWT_EXPIRATION=24h
METEORX_JWT_ISSUER=meteorx-auth

# --- Log ---
METEORX_LOG_LEVEL=info
METEORX_LOG_FORMAT=json

# --- IP Location ---
# IP 地理位置解析方式：http-api（在线）/ ip2region（离线）
METEORX_IP_LOCATION_PROVIDER=http-api
# ip2region 数据库文件路径（仅 provider=ip2region 时需要）
METEORX_IP_LOCATION_DB_PATH=./data/ip2region.xdb
# HTTP API 超时时间（秒）
METEORX_IP_LOCATION_TIMEOUT=3

# --- OAuth2 ---
# 刷新令牌有效期（Go Duration 格式），默认 168h（7 天）；改短可增强安全性
METEORX_OAUTH_REFRESH_TOKEN_TTL=168h
# CSRF state 有效期（Go Duration 格式），默认 10m；一般无需修改
METEORX_OAUTH_STATE_TTL=10m

# --- Auth ---
# API Token 最长有效期（Go Duration 格式），默认 2160h（90 天）
METEORX_AUTH_API_TOKEN_MAX_TTL=2160h

# --- Task Reminder ---
# 任务到期提醒定时任务（均为 Go Duration 格式，留空回落默认值）
# 提醒窗口（提前量），默认 24h
METEORX_TASK_REMINDER_HORIZON=24h
# 扫描间隔，默认 30m
METEORX_TASK_REMINDER_INTERVAL=30m
# 逾期任务重复提醒的最小间隔，默认 24h
METEORX_TASK_REMINDER_OVERDUE_COOLDOWN=24h
# 单次扫描发送提醒的最大任务数，默认 200
METEORX_TASK_REMINDER_BATCH_LIMIT=200

# --- AI (通用能力, OpenAI 兼容接口) ---
# 可选叠加层，默认关闭。关闭或未填 api_key 时，任务 AI 端点返回 503、前端按钮禁用，
# 不影响任务等核心业务流程。仅支持兼容 OpenAI /chat/completions 的端点（含自建网关）。
# 总开关：true / false
METEORX_AI_ENABLED=false
# OpenAI 兼容端点基址，留空默认 https://api.openai.com/v1
METEORX_AI_BASE_URL=
# 访问密钥（切勿提交真实值）
METEORX_AI_API_KEY=
# 默认模型，留空默认 gpt-4o-mini
METEORX_AI_MODEL=
# 采样温度，负值回落默认 0.2（0 为合法确定性取值）
METEORX_AI_TEMPERATURE=-1
# 单次补全最大 token，<=0 回落默认 512
METEORX_AI_MAX_TOKENS=0
# 上游调用超时（Go Duration 格式），<=0 回落默认 20s
METEORX_AI_TIMEOUT=20s

# --- Audit (审计日志：保留策略 + 防篡改完整性) ---
# 保留策略：>0 时由定时任务（每小时）物理删除 created_at 早于 N 天前的审计日志；
# 删除审计历史属敏感操作，默认 0=关闭（升级不自动删历史）；如 365 表示保留一年。
METEORX_AUDIT_RETENTION_DAYS=0
# 防篡改完整性总开关：true / false，默认 false。须与 secret_key 同时满足才生效，
# 否则整卡降级为关闭（不写摘要、不阻断审计写入）。
METEORX_AUDIT_INTEGRITY_ENABLED=false
# 行摘要/锚点链 pepper（切勿提交真实值）；生成：openssl rand -base64 32
METEORX_AUDIT_INTEGRITY_SECRET_KEY=
# 锚点链生成间隔（Go Duration 格式），<=0 回落默认 1h
METEORX_AUDIT_INTEGRITY_ANCHOR_INTERVAL=1h


# ============================================
# B. docker-compose.prod.yml 生产环境（宿主变量，compose 展开）
#    在 docker-compose.prod.yml 中以 ${DB_PASSWORD} 形式引用，
#    注入到容器内的 METEORX_DB_PASSWORD 等变量。
#    若同时运行直接启动，请保持与 A 区对应值一致。
# ============================================

# 数据库密码（生产环境务必修改）
DB_PASSWORD=meteorx_secure_password
# Redis 密码（生产环境务必修改）
REDIS_PASSWORD=
# JWT 密钥（生产环境务必修改，建议随机生成）
JWT_SECRET=change-this-secret-key-in-production


# ============================================
# 文件存储后端（默认 local 本地磁盘；切换云存储时取消注释并填写）
# ============================================
# storage_type: local | oss（阿里云 OSS）| s3（AWS S3 及 MinIO 等 S3 兼容端点）
#METEORX_FILE_STORAGE_TYPE=local
## 阿里云 OSS 示例
#METEORX_FILE_CLOUD_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
#METEORX_FILE_CLOUD_BUCKET=your-bucket
#METEORX_FILE_CLOUD_ACCESS_KEY=
#METEORX_FILE_CLOUD_SECRET_KEY=
## AWS S3 / MinIO 示例（S3 需 region；连接 MinIO 时填写 endpoint 并置 force_path_style=true）
#METEORX_FILE_CLOUD_REGION=us-east-1
#METEORX_FILE_CLOUD_ENDPOINT=
#METEORX_FILE_CLOUD_FORCE_PATH_STYLE=false
## 可选：对象键前缀 / 公开或 CDN 基址 / 私有桶预签名有效期（秒）
#METEORX_FILE_CLOUD_PATH_PREFIX=
#METEORX_FILE_CLOUD_PUBLIC_BASE_URL=
#METEORX_FILE_CLOUD_PRESIGN_TTL=3600


# ============================================
# 说明
# ============================================
# 1. 加载语义：config.yaml 始终作为默认值基底，.env 中的变量对其做覆盖。
#    （LoadConfig 始终读取 config.yaml，不再因 .env 存在而跳过）
# 2. 除上面列出的变量外，其他所有配置项均可通过
#    METEORX_<嵌套路径，点号转下划线> 覆盖，例如：
#    - METEORX_SECURITY_LOGIN_LOCKOUT_ENABLED
#    - METEORX_FILE_UPLOAD_PATH
#    - METEORX_EMAIL_ENABLED
#    - METEORX_CLIENT_BASE_URL
#    默认值仍来自 internal/config/config.yaml。
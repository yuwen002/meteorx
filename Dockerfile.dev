# 开发环境 Dockerfile（支持热重载）
FROM golang:1.21-alpine

WORKDIR /app

# 安装开发工具
RUN apk add --no-cache git gcc musl-dev

# 安装 air（热重载工具）
RUN go install github.com/cosmtrek/air@latest

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 暴露端口
EXPOSE 8080

# 启动开发服务器
CMD ["air", "-c", ".air.toml"]